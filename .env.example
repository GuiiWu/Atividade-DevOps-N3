# Copie para .env (cp .env.example .env) e ajuste se quiser.
# Senhas de EXEMPLO, apenas para o ambiente de laboratório. Nunca use senhas reais.

# Versão da imagem da API usada pelo Compose
APP_VERSION=1.0
API_PORT=3000

# Banco de dados (lidas pelo container do MySQL e pela API)
MYSQL_ROOT_PASSWORD=troque-root-123
MYSQL_DATABASE=loja
MYSQL_USER=loja
MYSQL_PASSWORD=troque-loja-123

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Tempo do cache de produtos no Redis (segundos)
CACHE_TTL=30
